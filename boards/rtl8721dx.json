{
  "build": {
    "core": "ambsdk",
    "cpu": "cortex-m33",
    "extra_flags": "-DRTL8721Dx -DAMEBADPLUS",
    "f_cpu": "150000000L",
    "mcu": "rtl8721dx",
    "soc": "RTL8721Dx",
    "ambsdk": {
      "family": "amebadplus",
      "asdk_version": "10.3.1",
      "default_app": "default"
    }
  },
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "debug": {
    "openocd_target": "rtl8721dx.cfg",
    "default_tool": "openocd"
  },
  "frameworks": [
    "ambsdk"
  ],
  "name": "Realtek RTL8721Dx (AmebaD-Plus)",
  "upload": {
    "maximum_ram_size": 524288,
    "maximum_size": 4194304,
    "protocol": "ameba",
    "protocols": [
      "ameba",
      "openocd",
      "jlink"
    ]
  },
  "url": "https://www.realmcu.com/en/Home/Products/Detail/RTL8721Dx",
  "vendor": "Realtek"
}
