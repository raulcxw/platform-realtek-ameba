{
  "build": {
    "core": "ambsdk",
    "cpu": "cortex-m33",
    "extra_flags": "-DRTL8720E -DAMEBALITE",
    "f_cpu": "100000000L",
    "mcu": "rtl8720e",
    "soc": "RTL8720E",
    "ambsdk": {
      "family": "amebalite",
      "asdk_version": "10.3.1",
      "default_app": "default"
    }
  },
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "debug": {
    "openocd_target": "rtl8720e.cfg",
    "default_tool": "openocd"
  },
  "frameworks": [
    "ambsdk"
  ],
  "name": "Realtek RTL8720E (AmebaLite)",
  "upload": {
    "maximum_ram_size": 524288,
    "maximum_size": 2097152,
    "protocol": "ameba",
    "protocols": [
      "ameba",
      "openocd",
      "jlink"
    ]
  },
  "url": "https://www.realmcu.com/en/Home/Products/Detail/RTL8720E",
  "vendor": "Realtek"
}
